{
  "name": "prawko",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:mobile": "pnpm --filter @prawko/mobile start",
    "dev:web": "pnpm --filter @prawko/web dev",
    "data:questions": "pnpm --filter @prawko/data-pipeline pipeline",
    "data:questions:inspect": "pnpm --filter @prawko/data-pipeline inspect",
    "data:questions:validate": "pnpm --filter @prawko/data-pipeline validate",
    "data:media:audit": "pnpm --filter @prawko/data-pipeline media:audit",
    "data:media:build": "pnpm --filter @prawko/data-pipeline media:build",
    "data:media:upload": "pnpm --filter @prawko/data-pipeline media:upload",
    "data:questions:sync": "pnpm --filter @prawko/data-pipeline questions:sync",
    "typecheck": "pnpm -r typecheck",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "supabase": "^2.26.9",
    "typescript": "^5.9.3"
  }
}
