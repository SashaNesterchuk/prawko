{
  "name": "prawko",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:mobile": "corepack pnpm --filter @prawko/mobile start",
    "dev:web": "corepack pnpm --filter @prawko/web dev",
    "data:road-signs:generate": "corepack pnpm --filter @prawko/mobile road-signs:generate",
    "data:questions": "corepack pnpm --filter @prawko/data-pipeline pipeline",
    "data:questions:inspect": "corepack pnpm --filter @prawko/data-pipeline inspect",
    "data:questions:validate": "corepack pnpm --filter @prawko/data-pipeline validate",
    "data:media:audit": "corepack pnpm --filter @prawko/data-pipeline media:audit",
    "data:media:build": "corepack pnpm --filter @prawko/data-pipeline media:build",
    "data:media:upload": "corepack pnpm --filter @prawko/data-pipeline media:upload",
    "data:storage:clear": "corepack pnpm --filter @prawko/data-pipeline storage:clear",
    "data:questions:sync": "corepack pnpm --filter @prawko/data-pipeline questions:sync",
    "data:question-ai-explanations:rewrite": "corepack pnpm --filter @prawko/data-pipeline question-ai-explanations:rewrite",
    "data:question-ai-explanations:verify": "corepack pnpm --filter @prawko/data-pipeline question-ai-explanations:verify",
    "data:question-ai-explanations:keep-ua": "corepack pnpm --filter @prawko/data-pipeline question-ai-explanations:keep-ua",
    "data:question-topics:from-xlsx": "corepack pnpm --filter @prawko/data-pipeline question-topics:from-xlsx",
    "data:question-topics:prepare": "corepack pnpm --filter @prawko/data-pipeline question-topics:prepare",
    "data:question-topics:sync": "corepack pnpm --filter @prawko/data-pipeline question-topics:sync",
    "typecheck": "corepack pnpm -r typecheck",
    "test:mobile": "corepack pnpm --filter @prawko/mobile test",
    "test:e2e:mobile": "corepack pnpm --filter @prawko/mobile test:e2e",
    "supabase:start": "corepack pnpm exec supabase start",
    "supabase:stop": "corepack pnpm exec supabase stop",
    "supabase:reset": "corepack pnpm exec supabase db reset"
  },
  "devDependencies": {
    "supabase": "^2.26.9",
    "typescript": "^5.9.3"
  }
}
