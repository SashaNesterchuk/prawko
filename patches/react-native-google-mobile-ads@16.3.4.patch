 #import "RNGoogleMobileAdsFullScreenAd.h"
 #import "RNGoogleMobileAdsCommon.h"
 
+static NSString *RNGoogleMobileAdsPaidAdNetwork(id ad) {
+  GADResponseInfo *info = nil;
+  if ([ad isKindOfClass:[GADInterstitialAd class]]) {
+    info = [(GADInterstitialAd *)ad responseInfo];
+  } else if ([ad isKindOfClass:[GADRewardedAd class]]) {
+    info = [(GADRewardedAd *)ad responseInfo];
+  } else if ([ad isKindOfClass:[GADRewardedInterstitialAd class]]) {
+    info = [(GADRewardedInterstitialAd *)ad responseInfo];
+  } else if ([ad isKindOfClass:[GADAppOpenAd class]]) {
+    info = [(GADAppOpenAd *)ad responseInfo];
+  }
+
+  GADAdNetworkResponseInfo *loaded = info.loadedAdNetworkResponseInfo;
+  if (loaded.adSourceName.length > 0) {
+    return loaded.adSourceName;
+  }
+  if (loaded.adNetworkClassName.length > 0) {
+    return loaded.adNetworkClassName;
+  }
+  return @"unknown";
+}
+
 @implementation RNGoogleMobileAdsFullScreenAd
 
