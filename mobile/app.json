{
  "expo": {
    "name": "Prawko",
    "slug": "prawko",
    "scheme": "prawko",
    "version": "0.1.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.mindjar.prawko"
    },
    "ios": {
      "bundleIdentifier": "com.mindjar.prawko",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "This app uses notifications to remind you about study sessions."
      }
    }
  }
}
