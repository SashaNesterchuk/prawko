{
  "name": "@prawko/mobile",
  "private": true,
  "version": "0.1.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:e2e": "EXPO_PUBLIC_E2E_TEST_MODE=1 expo run:android",
    "ios": "EXPO_UNSTABLE_MCP_SERVER=1 expo run:ios",
    "ios:e2e": "EXPO_PUBLIC_E2E_TEST_MODE=1 EXPO_UNSTABLE_MCP_SERVER=1 expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/features/ads/**/*.{ts,tsx}' --collectCoverageFrom='!src/features/ads/__tests__/**' --collectCoverageFrom='!src/features/ads/AdProvider.tsx' --collectCoverageFrom='!src/features/ads/AppResumeAdListener.tsx' --collectCoverageFrom='!src/features/ads/use-should-show-ads.ts'",
    "icons:generate": "node scripts/generate-icon-registry.mjs",
    "offline:sizes:generate": "node scripts/generate-offline-asset-size-map.mjs",
    "road-signs:generate": "node scripts/generate-road-signs-content.mjs",
    "test:e2e": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro test .maestro",
    "test:e2e:smoke": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro test .maestro --include-tags smoke",
    "test:e2e:studio": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro studio"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@prawko/config": "workspace:*",
    "@prawko/schemas": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/metro-config": "^0.86.2",
    "@supabase/supabase-js": "2.106.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.16",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-observe": "~57.0.17",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-video": "~57.0.2",
    "i18next": "^24.2.1",
    "posthog-react-native": "^4.10.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-i18next": "^15.4.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-purchases": "^10.7.0",
    "react-native-purchases-ui": "^10.7.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.15",
    "babel-jest": "^29.7.0",
    "expo-mcp": "~0.2.1",
    "jest": "^29.7.0",
    "typescript": "^6.0.3"
  }
}
