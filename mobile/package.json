{
  "name": "@prawko/mobile",
  "private": true,
  "version": "0.1.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:e2e": "EXPO_PUBLIC_E2E_TEST_MODE=1 expo run:android",
    "ios": "EXPO_UNSTABLE_MCP_SERVER=1 expo run:ios",
    "ios:e2e": "EXPO_PUBLIC_E2E_TEST_MODE=1 EXPO_UNSTABLE_MCP_SERVER=1 expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons:generate": "node scripts/generate-icon-registry.mjs",
    "offline:sizes:generate": "node scripts/generate-offline-asset-size-map.mjs",
    "road-signs:generate": "node scripts/generate-road-signs-content.mjs",
    "test:e2e": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro test .maestro",
    "test:e2e:smoke": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro test .maestro --include-tags smoke",
    "test:e2e:studio": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro studio"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@prawko/config": "workspace:*",
    "@prawko/schemas": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "2.106.2",
    "expo": "^54.0.11",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.7",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.9",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-video": "~3.0.16",
    "i18next": "^24.2.1",
    "posthog-react-native": "^4.10.8",
    "react": "19.1.0",
    "react-freeze": "^1.0.4",
    "react-i18next": "^15.4.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-is-edge-to-edge": "^1.3.1",
    "react-native-mmkv": "^3.2.0",
    "react-native-purchases": "^8.8.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^19.1.17",
    "expo-mcp": "~0.2.1",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "^5.9.3"
  }
}
